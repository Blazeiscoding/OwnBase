{
  "name": "ownbase",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:win": "pnpm --filter @ownbase/desktop package --win",
    "build:mac": "pnpm --filter @ownbase/desktop package --mac",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "coverage": "node scripts/coverage.mjs",
    "format": "prettier --write .",
    "typecheck:automation": "tsc -p tsconfig.automation.json",
    "visualizer:build": "node scripts/generate-project-visualizer.mjs",
    "visualizer:check": "node scripts/generate-project-visualizer.mjs --check",
    "visualizer:test": "node --test scripts/generate-project-visualizer.test.mjs",
    "visualizer:serve": "node scripts/serve-project-visualizer.mjs"
  },
  "devDependencies": {
    "@emoji-mart/data": "1.2.1",
    "@fontsource/noto-color-emoji": "5.3.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@electron/universal>minimatch": "^11.0.1",
      "app-builder-lib>minimatch": "^11.0.1"
    }
  }
}
