{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml", ".npmrc", ".pnpmfile.cjs"],
  "globalEnv": ["CI", "NODE_ENV"],
  "cacheMaxAge": "7d",
  "cacheMaxSize": "100MB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "$TURBO_ROOT$/scripts/build-identity.mjs"],
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_THREADS", "VITEST_MAX_FORKS"]
    },
    "@ownbase/desktop#test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_THREADS", "VITEST_MAX_FORKS"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tests/fixtures/**"]
    },
    "@ownbase/server#test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_THREADS", "VITEST_MAX_FORKS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/INTEGRATIONS.md",
        "$TURBO_ROOT$/apps/desktop/src/renderer/index.html"
      ]
    },
    "@ownbase/ui#test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_THREADS", "VITEST_MAX_FORKS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src/main/index.ts",
        "$TURBO_ROOT$/apps/desktop/src/renderer/index.html",
        "$TURBO_ROOT$/apps/desktop/src/renderer/public/ownbase.svg",
        "$TURBO_ROOT$/apps/desktop/src/renderer/public/first-paint.js",
        "$TURBO_ROOT$/apps/web/index.html",
        "$TURBO_ROOT$/apps/web/public/ownbase.svg",
        "$TURBO_ROOT$/apps/web/public/first-paint.js",
        "$TURBO_ROOT$/apps/web/public/notification-worker.js"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
