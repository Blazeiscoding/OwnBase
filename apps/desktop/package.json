{
  "name": "@ownbase/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "OwnBase — self-hosted team chat",
  "author": "OwnBase contributors",
  "scripts": {
    "dev": "node scripts/build-microphone.mjs && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "pnpm --filter @ownbase/web build && node scripts/build-microphone.mjs && electron-vite build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.2",
    "bonjour-service": "^1.3.0",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.8",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@ownbase/client-core": "workspace:*",
    "@ownbase/protocol": "workspace:*",
    "@ownbase/server": "workspace:*",
    "@ownbase/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^44.11.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
